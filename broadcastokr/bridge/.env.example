# Bridge server configuration
BRIDGE_PORT=3001
# Default is 127.0.0.1 (local-only). Set 0.0.0.0 only to expose on the network (Docker sets this itself).
BRIDGE_HOST=127.0.0.1
BRIDGE_API_KEY=change-me-to-a-random-secret
BRIDGE_LOG_DIR=./logs
BRIDGE_BACKUP_DIR=./backups
BRIDGE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (defense-in-depth). Max requests per IP per window.
# /api/health is always exempt. Defaults: 600 requests / 60000 ms.
BRIDGE_RATE_LIMIT=600
BRIDGE_RATE_WINDOW_MS=60000

# Optional: Oracle Instant Client path
# ORACLE_CLIENT_DIR=/opt/oracle/instantclient

# ── Cloud editions (BRIDGE_MODE=client | cockpit) ──
# The bridge refuses to start in a cloud mode until all four OIDC values and the
# encryption key are set (docs/operations.md, "Identity (OIDC)"). Desktop mode
# ignores them.
# BRIDGE_MODE=client
# BRIDGE_OIDC_ISSUER=https://idp.example.com/realms/brokr
# BRIDGE_OIDC_CLIENT_ID=brokr
# BRIDGE_OIDC_CLIENT_SECRET=change-me
# BRIDGE_BASE_URL=https://okr.example.com
# BRIDGE_ENCRYPTION_KEY=change-me-to-a-long-random-secret
